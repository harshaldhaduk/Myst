# Copy to .env and fill in. .env is gitignored; never commit the real key.

# CompreFace server (from face-demo/compreface/docker-compose.yml)
COMPREFACE_URL=http://localhost:8000

# Recognition service API key: CompreFace UI -> your application -> the Recognition service -> API key
COMPREFACE_API_KEY=

# Similarity below this is shown as "Unknown". Range 0-1; higher = stricter.
SIMILARITY_THRESHOLD=0.85
